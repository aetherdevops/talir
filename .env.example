# Copy to .env.local and fill in values from:
# Supabase Dashboard → Project Settings → API
#
# Auth redirect URL (Supabase → Authentication → URL configuration):
#   http://localhost:3000/auth/callback
#   http://localhost:3000/auth/confirm

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public site origin (no trailing slash) — used in auth confirmation links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CI/scripts only — never expose as NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend (auth confirmation + transactional email)
# RESEND_API_KEY=re_...
# RESEND_FROM=Talir <no-reply@talir.mk>

# Supabase Auth → Hooks → Send Email (HTTPS) webhook secret
# Format from dashboard: v1,whsec_<base64>
# SEND_EMAIL_HOOK_SECRET=v1,whsec_...

# Opt-in Supabase document store: metadata + parsed fields only (no PDFs or OCR text blobs).
# OCR text is cached locally in lib/data/dividend_ocr_cache.json during ingest.
# TALIR_DOCUMENT_STORE=supabase

# Ingest scope: MBI10 (default) or ALL issuers
# TALIR_SCOPE=ALL

# Admin allowlist for /admin/dividends (comma-separated emails, case-insensitive)
# TALIR_ADMIN_EMAILS=you@example.com

# One-time: for npm run db:apply (Account → Access Tokens — never commit)
# SUPABASE_ACCESS_TOKEN=sbp_...

# One-time: for npm run gh:secrets (GitHub PAT with repo admin — never commit)
# GITHUB_TOKEN=ghp_...
